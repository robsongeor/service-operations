    "test:equipment": "node --experimental-strip-types --test tests/equipmentDataCache.test.ts tests/equipmentDataQuality.test.ts tests/equipmentMap.test.ts tests/equipmentPagination.test.ts tests/equipmentRealtime.test.ts tests/equipmentRealtimeApi.test.cjs tests/greentreeEquipmentReconciliation.test.ts",
