# Microsoft Entra app registration
VITE_MSAL_CLIENT_ID=your-application-client-id
VITE_MSAL_TENANT_ID=your-directory-tenant-id
# Optional after registering https://your-app.example/auth/silent.html as an SPA redirect URI.
# Without this, the registered application root is used with the embedded-auth bootstrap guard.
VITE_MSAL_SILENT_REDIRECT_URI=

# Dataverse organization URL, without /api/data/v9.2 or a trailing slash
VITE_DATAVERSE_URL=https://your-environment.crm.dynamics.com

# Keep false until the Entra application roles and matching Dataverse roles are assigned.
# Supported Entra application-role values are ServiceOperations.FullAccess,
# ServiceOperations.JobCardAdmin, and ServiceOperations.JobBookOnly. FullAccess takes precedence.
VITE_APPLICATION_ACCESS_CONTROL_ENABLED=false

# Development only: full, job-card-admin, job-book-only, or denied. Production builds ignore this value.
VITE_SIMULATED_ACCESS_MODE=

# The Job Book Entry Contact lookup is provisioned and role-tested.
VITE_JOB_BOOK_CONTACT_LOOKUP_ENABLED=true

# Enable regional views only after their Dataverse tables exist. Allocation remains off until
# legacy rows are migrated and each independent AutoNumber seed passes cutover verification.
VITE_REGIONAL_JOB_BOOKS_ENABLED=false
VITE_REGIONAL_JOB_BOOK_ALLOCATION_ENABLED=false

# Server-only key used by the local /api/equipmentgeocode Vite middleware.
# Keep the real value in .env.local; never expose it with a VITE_ prefix.
GEOAPIFY_API_KEY=your-geoapify-api-key

# Optional local build label. Production values are injected from Git metadata.
VITE_APP_VERSION=Development
VITE_APP_VERSION_IS_RELEASE=false

# Keep false until transactional Job registration, schema, privilege gates and migration are approved.
# No legacy-table fallback is used by this operation. The current screens are not switched over yet.
VITE_UNIFIED_JOB_REGISTRATION_ENABLED=false
VITE_UNIFIED_JOB_WORKFLOW_ENABLED=false

# Optional public raster-tile template for local/provider overrides. By default both maps use the
# same-origin /api/maptile proxy, backed by the server-only GEOAPIFY_API_KEY above.
VITE_EQUIPMENT_MAP_TILE_URL=

# Optional standalone Azure Function App /api base URL for Dataverse Equipment change notifications.
# Leave blank until Azure SignalR and realtime-api are deployed.
VITE_EQUIPMENT_REALTIME_API_URL=

# Optional public origin used in links sent to technicians. Set this during localhost
# development so phones open the deployed app instead of http://localhost:5173.
VITE_PUBLIC_APP_URL=https://your-app.example


# Keep false until the Job Hour Meter Reading Type Choice is provisioned and verified.
VITE_HOUR_METER_CLASSIFICATION_ENABLED=false
VITE_JOB_CARD_METER_APPROVAL_ENABLED=false
VITE_JOB_CARD_CURSOR_QUEUE_ENABLED=false
# Backend only. Enable after approval-reference schema, writer permissions and licensing acceptance.
JOB_CARD_METER_APPROVAL_ENABLED=false
# Backend-only dedicated application user; never reuse the GreenTree/browser identity.
JOB_CARD_METER_DATAVERSE_TENANT_ID=
JOB_CARD_METER_DATAVERSE_CLIENT_ID=
JOB_CARD_METER_DATAVERSE_CLIENT_SECRET=

# Enable only after gr_job.gr_externalsupplierdetails, the Job Book registration API parameter,
# and matching signed plugins are deployed together.
VITE_EXTERNAL_SUPPLIER_ASSIGNMENT_ENABLED=false

# Server-side Lift Trucks API credentials for the Vite development proxy.
# Azure Functions local development uses ignored api/local.settings.json instead.
# Never prefix these values with VITE_.
LIFTTRUCKS_API_USERNAME=your-lifttrucks-api-username
LIFTTRUCKS_API_PASSWORD=your-lifttrucks-api-password
# Equipment Photo upload release gate and server-only Microsoft Graph identity.
# Grant this application Graph application permission Sites.Selected, then grant it
# write access only to the Liftrucks Team Site. Never prefix credentials with VITE_.
EQUIPMENT_PHOTO_UPLOAD_ENABLED=false
SHAREPOINT_TENANT_ID=your-directory-tenant-id
SHAREPOINT_CLIENT_ID=your-sharepoint-application-client-id
SHAREPOINT_CLIENT_SECRET=your-sharepoint-application-client-secret
SHAREPOINT_HOSTNAME=liftrucksnz.sharepoint.com
SHAREPOINT_SITE_PATH=/
SHAREPOINT_LIBRARY_NAME=Working Folder
SHAREPOINT_ROOT_FOLDER=Workshop/Equipment Photo Storage

# Local Job Card testing only; never copy these shortcuts to Azure.
JOB_CARD_STORAGE_MODE=memory
JOB_CARD_LOCAL_DEVELOPMENT=true
JOB_CARD_NOTIFICATION_MODE=console
